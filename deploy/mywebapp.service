[Unit]
Description=mywebapp Notes Service
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=mywebapp
Group=mywebapp
WorkingDirectory=/opt/mywebapp
EnvironmentFile=/etc/mywebapp/db.env
ExecStartPre=/opt/mywebapp/venv/bin/python migrate.py \
    --db-host 127.0.0.1 --db-port 3306 \
    --db-user ${DB_USER} --db-password ${DB_PASSWORD} --db-name ${DB_NAME}
ExecStart=/opt/mywebapp/venv/bin/python server.py \
    --host 127.0.0.1 --port 5200 \
    --db-host 127.0.0.1 --db-port 3306 \
    --db-user ${DB_USER} --db-password ${DB_PASSWORD} --db-name ${DB_NAME}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target